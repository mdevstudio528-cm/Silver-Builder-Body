# ============================================================
#  Administrador Financiero UR — variables de entorno
#  Copia este archivo como .env y llena los valores.
#  .env NUNCA se sube a git (ya está en .gitignore).
# ============================================================

# ---------- SIEMPRE ----------
# Firma de las cookies de sesión. Genera con: openssl rand -base64 48
# Si la cambias, todas las sesiones abiertas se cierran.
SESSION_SECRET=

# Zona horaria para "hoy" (los cortes de mes y los vencimientos usan esta zona)
APP_TIMEZONE=America/Mexico_City

# Origen permitido para CORS. En local no hace falta (el proxy lo evita).
ALLOWED_ORIGIN=http://localhost:4200


# ---------- DÓNDE SE GUARDAN LOS DATOS ----------
# file   = desarrollo, escribe en data/*.json (cero credenciales)
# sheets = producción, escribe en la hoja privada de Google
SHEETS_DRIVER=file

# Solo se usa con SHEETS_DRIVER=file
DATA_DIR=./data


# ---------- SOLO SI SHEETS_DRIVER=sheets ----------
# Id de la hoja NUEVA de este proyecto.
# NO uses la hoja de Urban Rocket: este proyecto es independiente.
# Se saca de la URL: docs.google.com/spreadsheets/d/  <<AQUI>>  /edit
SHEET_ID=

# JSON completo de la clave de la cuenta de servicio (una sola línea).
# Google Cloud → IAM y administración → Cuentas de servicio → Claves → Agregar clave (JSON)
# También se acepta el mismo JSON en base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# IMPORTANTE: abre la hoja → Compartir → pega el correo de la cuenta de
# servicio (termina en @...iam.gserviceaccount.com) con permiso EDITOR.
# Sin eso la API responde 403 y la app no puede leer ni escribir.

# Después de llenar SHEET_ID y GOOGLE_SERVICE_ACCOUNT_JSON:
#   npm run verificar:hoja        ← comprueba firma, acceso, pestañas y escritura
#   SHEETS_DRIVER=sheets          ← y reinicia npm run dev:api
